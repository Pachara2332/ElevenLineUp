// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId           String            @id @default(cuid()) @map("id")
  email            String            @unique
  password         String
  name             String
  avatar           String?
  lineups          Lineup[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  matchPredictions MatchPrediction[]
  userGameStats    UserGameStats[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("NotificationActor")
  refreshTokens     RefreshToken[]

  // Community Relations
  followers Follow[]   @relation("UserFollowers")
  following Follow[]   @relation("UserFollowing")
  pollVotes PollVote[]
  polls     Poll[]

  @@map("User")
}

// ... (Existing models usually here, but I will append new ones at the end of the file or where appropriate)

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [userId], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [userId], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("Follow")
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // Polymorphic-like associations (optional relations)
  lineupId String?
  lineup   Lineup? @relation(fields: [lineupId], references: [lineupId], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lineupId, postId, commentId, teamId]) // Prevent duplicate likes
  @@map("Like")
}

model Poll {
  id       String @id @default(cuid())
  question String

  userId  String
  creator User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  options PollOption[]
  votes   PollVote[]

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("Poll")
}

model PollOption {
  id     String     @id @default(cuid())
  text   String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@map("PollOption")
}

model PollVote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, pollId]) // One vote per poll per user
  @@map("PollVote")
}

model Team {
  teamId      String            @id @default(cuid()) @map("id")
  name        String
  league      String
  logo        String
  players     Json
  lineups     Lineup[]
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  predictions MatchPrediction[]
  createdAt   DateTime          @default(now())

  @@map("Team")
}

model Lineup {
  lineupId  String  @id @default(cuid()) @map("id")
  name      String
  formation String  @default("4-3-3")
  isPublic  Boolean @default(false)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  slots LineupSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     Like[]

  @@map("Lineup")
}

model LineupSlot {
  slotId String @id @default(cuid()) @map("id")

  lineupId String @map("lineup_id")
  lineup   Lineup @relation(fields: [lineupId], references: [lineupId], onDelete: Cascade)

  position String
  x        Float
  y        Float

  playerId    String?
  playerName  String?
  playerImage String?

  @@map("LineupSlot")
}

model LeagueStanding {
  id             String  @id @default(cuid())
  league         String
  season         String
  teamName       String
  position       Int
  played         Int
  won            Int
  drawn          Int
  lost           Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int     @default(0) // Pre-calculated: goalsFor - goalsAgainst
  points         Int
  form           String?

  updatedAt DateTime @updatedAt

  @@unique([league, season, teamName])
  @@index([league, season, position, goalDifference])
  @@map("LeagueStanding")
}

model Fixture {
  id        String   @id @default(cuid())
  league    String
  season    String
  homeTeam  String
  awayTeam  String
  kickoff   DateTime
  status    String // scheduled, live, finished
  homeScore Int?
  awayScore Int?

  updatedAt DateTime @updatedAt

  predictions MatchPrediction[]

  @@unique([league, season, homeTeam, awayTeam, kickoff])
  @@map("Fixture")
}

model MatchPrediction {
  id        String @id @default(cuid())
  userId    String
  fixtureId String

  predictedHome Int
  predictedAway Int
  points        Int? // Calculated after match finishes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)

  teamTeamId String?

  @@unique([userId, fixtureId])
  @@map("MatchPrediction")
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  author        User           @relation(fields: [authorId], references: [userId])
  comments      Comment[]
  likes         Like[]
  team          Team?          @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId    String?
  notifications Notification[]

  @@map("Post")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  post       Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  team       Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId String?
  likes      Like[]

  @@map("Comment")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String // Recipient (Post Owner)
  actorId   String // Actor (Liker/Commenter)
  type      String // 'LIKE', 'COMMENT'
  message   String
  isRead    Boolean  @default(false)
  postId    String?
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [userId], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [userId], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Mini Games System ---

model DailyTicTacToe {
  id        String   @id @default(cuid())
  date      DateTime @unique
  rows      Json // Array of {label, type, value}
  cols      Json // Array of {label, type, value}
  solutions Json // { "0-0": ["playerId1"], "0-1": ... }

  createdAt DateTime @default(now())

  @@map("DailyTicTacToe")
}

model DailyMissingXI {
  id        String   @id @default(cuid())
  date      DateTime @unique
  teamName  String
  formation String
  players   Json // Array of slots { position, name, x, y, isMissing } 

  createdAt DateTime @default(now())

  @@map("DailyMissingXI")
}

model DailyWhoAreYa {
  id            String   @id @default(cuid())
  date          DateTime @unique
  playerId      String? // Optional link to scraped player ID if we had a Player model
  playerName    String
  teamName      String?
  blurredImage  String
  pixelateLevel Int      @default(10)

  createdAt DateTime @default(now())

  @@map("DailyWhoAreYa")
}

model UserGameStats {
  id       String @id @default(cuid())
  userId   String
  gameType String // "TIC_TAC_TOE", "MISSING_XI", "WHO_ARE_YA"

  currentStreak Int       @default(0)
  maxStreak     Int       @default(0)
  lastPlayedAt  DateTime?
  totalPlayed   Int       @default(0)
  totalWins     Int       @default(0)

  history Json? // Detailed history log

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameType])
  @@map("UserGameStats")
}

// --- Auth System ---

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("RefreshToken")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("PasswordResetToken")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String // Target email (doesn't need to exist in User table)
  ipAddress String
  isSuccess Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, ipAddress])
  @@map("LoginAttempt")
}
