// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId           String            @id @default(cuid()) @map("id")
  email            String            @unique
  password         String
  name             String
  role             String            @default("USER")
  avatar           String?
  lineups          Lineup[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  matchPredictions MatchPrediction[]
  userGameStats    UserGameStats[]
  userStats        UserStats?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("NotificationActor")
  refreshTokens     RefreshToken[]

  // Community Relations
  followers     Follow[]           @relation("UserFollowers")
  following     Follow[]           @relation("UserFollowing")
  pollVotes     PollVote[]
  polls         Poll[]
  favoriteTeams UserFavoriteTeam[]

  // Phase B & C Relations
  matchMessages MatchMessage[]
  weeklyEntries WeeklyEntry[]
  quizAttempts  QuizAttempt[]

  @@map("User")
}

// ... (Existing models usually here, but I will append new ones at the end of the file or where appropriate)

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [userId], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowers", fields: [followingId], references: [userId], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("Follow")
}

model Like {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  // Polymorphic-like associations (optional relations)
  lineupId String?
  lineup   Lineup? @relation(fields: [lineupId], references: [lineupId], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, lineupId, postId, commentId, teamId]) // Prevent duplicate likes
  @@map("Like")
}

model Poll {
  id       String @id @default(cuid())
  question String

  userId  String
  creator User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  options PollOption[]
  votes   PollVote[]

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("Poll")
}

model PollOption {
  id     String     @id @default(cuid())
  text   String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@map("PollOption")
}

model PollVote {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, pollId]) // One vote per poll per user
  @@map("PollVote")
}

model Team {
  teamId      String             @id @default(cuid()) @map("id")
  name        String
  league      String
  logo        String
  players     Json
  lineups     Lineup[]
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  predictions MatchPrediction[]
  favoritedBy UserFavoriteTeam[]
  createdAt   DateTime           @default(now())

  @@map("Team")
}

model Lineup {
  lineupId  String  @id @default(cuid()) @map("id")
  name      String
  formation String  @default("4-3-3")
  isPublic  Boolean @default(false)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  slots LineupSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  likes     Like[]

  @@map("Lineup")
}

model LineupSlot {
  slotId String @id @default(cuid()) @map("id")

  lineupId String @map("lineup_id")
  lineup   Lineup @relation(fields: [lineupId], references: [lineupId], onDelete: Cascade)

  position String
  x        Float
  y        Float

  playerId    String?
  playerName  String?
  playerImage String?

  @@map("LineupSlot")
}

model LeagueStanding {
  id             String  @id @default(cuid())
  league         String
  season         String
  teamName       String
  position       Int
  played         Int
  won            Int
  drawn          Int
  lost           Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int     @default(0) // Pre-calculated: goalsFor - goalsAgainst
  points         Int
  form           String?

  updatedAt DateTime @updatedAt

  @@unique([league, season, teamName])
  @@index([league, season, position, goalDifference])
  @@map("LeagueStanding")
}

model Fixture {
  id        String   @id @default(cuid())
  league    String
  season    String
  homeTeam  String
  awayTeam  String
  kickoff   DateTime
  status    String // scheduled, live, finished
  homeScore Int?
  awayScore Int?

  updatedAt DateTime @updatedAt

  predictions MatchPrediction[]

  @@unique([league, season, homeTeam, awayTeam, kickoff])
  @@map("Fixture")
}

model MatchPrediction {
  id        String @id @default(cuid())
  userId    String
  fixtureId String

  predictedHome Int
  predictedAway Int
  points        Int? // Calculated after match finishes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)

  teamTeamId String?

  @@unique([userId, fixtureId])
  @@map("MatchPrediction")
}

model Post {
  id           String   @id @default(cuid())
  authorId     String
  content      String
  imageUrl     String?
  likeCount    Int      @default(0) // For feed ranking
  commentCount Int      @default(0) // For feed ranking
  createdAt    DateTime @default(now())

  author     User      @relation(fields: [authorId], references: [userId])
  comments   Comment[]
  likes      Like[]
  team       Team?     @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId String?

  @@map("Post")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  post       Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  team       Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId String?
  likes      Like[]

  @@map("Comment")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String // Recipient
  actorId   String // User who triggered it
  type      NotificationType // e.g., LIKE, COMMENT
  entityId  String? // The postId, commentId, etc.
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User @relation("UserNotifications", fields: [userId], references: [userId], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [userId], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("Notification")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  POLL_VOTE
}

model UserFavoriteTeam {
  id     String @id @default(uuid())
  userId String
  teamId String

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("UserFavoriteTeam")
}

// --- Mini Games System ---

model DailyTicTacToe {
  id        String   @id @default(cuid())
  date      DateTime @unique
  rows      Json // Array of {label, type, value}
  cols      Json // Array of {label, type, value}
  solutions Json // { "0-0": ["playerId1"], "0-1": ... }

  createdAt DateTime @default(now())

  @@map("DailyTicTacToe")
}

model DailyMissingXI {
  id        String   @id @default(cuid())
  date      DateTime @unique
  teamName  String
  formation String
  players   Json // Array of slots { position, name, x, y, isMissing } 

  createdAt DateTime @default(now())

  @@map("DailyMissingXI")
}

model DailyWhoAreYa {
  id            String   @id @default(cuid())
  date          DateTime @unique
  playerId      String? // Optional link to scraped player ID if we had a Player model
  playerName    String
  teamName      String?
  blurredImage  String
  pixelateLevel Int      @default(10)

  createdAt DateTime @default(now())

  @@map("DailyWhoAreYa")
}

model UserGameStats {
  id       String @id @default(cuid())
  userId   String
  gameType String // "TIC_TAC_TOE", "MISSING_XI", "WHO_ARE_YA"

  currentStreak Int       @default(0)
  maxStreak     Int       @default(0)
  lastPlayedAt  DateTime?
  totalPlayed   Int       @default(0)
  totalWins     Int       @default(0)

  history Json? // Detailed history log

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameType])
  @@map("UserGameStats")
}

// --- Auth System ---

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("RefreshToken")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("PasswordResetToken")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String // Target email (doesn't need to exist in User table)
  ipAddress String
  isSuccess Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, ipAddress])
  @@map("LoginAttempt")
}

// --- Phase B: Live Match Thread ---

model MatchThread {
  id        String         @id @default(uuid())
  fixtureId String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  messages  MatchMessage[]

  @@map("MatchThread")
}

model MatchMessage {
  id        String   @id @default(uuid())
  threadId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  thread MatchThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("MatchMessage")
}

// --- Phase C: Weekly Lineup Challenge ---

model WeeklyChallenge {
  id        String        @id @default(uuid())
  week      Int           @unique
  budget    Int
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  entries   WeeklyEntry[]

  @@map("WeeklyChallenge")
}

model WeeklyEntry {
  id          String @id @default(uuid())
  challengeId String
  userId      String
  totalPoints Int    @default(0)
  lineup      Json // { formation: "4-3-3", players: [{id, position, cost, points}] }

  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("WeeklyEntry")
}

// --- Phase D: Reputation & Barage System ---

model UserStats {
  id             String   @id @default(uuid())
  userId         String   @unique
  xp             Int      @default(0)
  predictionWins Int      @default(0)
  postsCount     Int      @default(0)
  badges         String[] @default([]) // Array of badge names, e.g., ["Tactical Genius"]

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("UserStats")
}

// --- Phase E: Football Brain Games Hub (Quiz System) ---

enum QuizType {
  TEXT
  IMAGE
  MISSING_XI
  WHO_AM_I
  TRANSFER
}

enum QuizDifficulty {
  CASUAL
  COMPETITIVE
  HARDCORE
}

model Quiz {
  id         String         @id @default(uuid())
  type       QuizType
  difficulty QuizDifficulty @default(CASUAL)
  question   String?
  imageUrl   String?
  answer     String
  options    Json?
  createdAt  DateTime       @default(now())

  attempts QuizAttempt[]

  @@map("Quiz")
}

model QuizAttempt {
  id        String   @id @default(uuid())
  quizId    String
  userId    String
  isCorrect Boolean
  timeTaken Int // In seconds
  hintsUsed Int      @default(0)
  xpEarned  Int      @default(0)
  createdAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("QuizAttempt")
}
