// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId           String            @id @default(cuid()) @map("id")
  email            String            @unique
  password         String
  name             String
  avatar           String?  
  lineups          Lineup[]
  posts            Post[]
  comments         Comment[]
  likes            Like[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  matchPredictions MatchPrediction[]
  userGameStats    UserGameStats[]

  @@map("User")
}

model Team {
  teamId      String            @id @default(cuid()) @map("id")
  name        String
  league      String
  logo        String
  players     Json
  lineups     Lineup[]
  posts       Post[]
  comments    Comment[]
  likes       Like[]
  predictions MatchPrediction[]
  createdAt   DateTime          @default(now())

  @@map("Team")
}

model Lineup {
  lineupId  String  @id @default(cuid()) @map("id")
  name      String
  formation String  @default("4-3-3")
  isPublic  Boolean @default(false)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  slots LineupSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Lineup")
}

model LineupSlot {
  slotId String @id @default(cuid()) @map("id")

  lineupId String @map("lineup_id")
  lineup   Lineup @relation(fields: [lineupId], references: [lineupId], onDelete: Cascade)

  position String
  x        Float
  y        Float

  playerId    String?
  playerName  String?
  playerImage String?

  @@map("LineupSlot")
}

model LeagueStanding {
  id             String  @id @default(cuid())
  league         String
  season         String
  teamName       String
  position       Int
  played         Int
  won            Int
  drawn          Int
  lost           Int
  goalsFor       Int
  goalsAgainst   Int
  goalDifference Int     @default(0) // Pre-calculated: goalsFor - goalsAgainst
  points         Int
  form           String?

  updatedAt DateTime @updatedAt

  @@unique([league, season, teamName])
  @@index([league, season, position, goalDifference])
  @@map("LeagueStanding")
}

model Fixture {
  id        String   @id @default(cuid())
  league    String
  season    String
  homeTeam  String
  awayTeam  String
  kickoff   DateTime
  status    String // scheduled, live, finished
  homeScore Int?
  awayScore Int?

  updatedAt DateTime @updatedAt

  predictions MatchPrediction[]

  @@unique([league, season, homeTeam, awayTeam, kickoff])
  @@map("Fixture")
}

model MatchPrediction {
  id        String @id @default(cuid())
  userId    String
  fixtureId String

  predictedHome Int
  predictedAway Int
  points        Int? // Calculated after match finishes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  fixture Fixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  team    Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)

  teamTeamId String?

  @@unique([userId, fixtureId])
  @@map("MatchPrediction")
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  author     User      @relation(fields: [authorId], references: [userId])
  comments   Comment[]
  likes      Like[]
  team       Team?     @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId String?

  @@map("Post")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  post       Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  team       Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId String?

  @@map("Comment")
}

model Like {
  id     String @id @default(cuid())
  postId String
  userId String

  post       Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  team       Team?   @relation(fields: [teamTeamId], references: [teamId], onDelete: SetNull)
  teamTeamId String?

  @@unique([postId, userId])
  @@map("Like")
}

// --- Mini Games System ---

model DailyTicTacToe {
  id        String   @id @default(cuid())
  date      DateTime @unique
  rows      Json // Array of {label, type, value}
  cols      Json // Array of {label, type, value}
  solutions Json // { "0-0": ["playerId1"], "0-1": ... }

  createdAt DateTime @default(now())

  @@map("DailyTicTacToe")
}

model DailyMissingXI {
  id        String   @id @default(cuid())
  date      DateTime @unique
  teamName  String
  formation String
  players   Json // Array of slots { position, name, x, y, isMissing } 

  createdAt DateTime @default(now())

  @@map("DailyMissingXI")
}

model DailyWhoAreYa {
  id            String   @id @default(cuid())
  date          DateTime @unique
  playerId      String? // Optional link to scraped player ID if we had a Player model
  playerName    String
  teamName      String?
  blurredImage  String
  pixelateLevel Int      @default(10)

  createdAt DateTime @default(now())

  @@map("DailyWhoAreYa")
}

model UserGameStats {
  id       String @id @default(cuid())
  userId   String
  gameType String // "TIC_TAC_TOE", "MISSING_XI", "WHO_ARE_YA"

  currentStreak Int       @default(0)
  maxStreak     Int       @default(0)
  lastPlayedAt  DateTime?
  totalPlayed   Int       @default(0)
  totalWins     Int       @default(0)

  history Json? // Detailed history log

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameType])
  @@map("UserGameStats")
}
